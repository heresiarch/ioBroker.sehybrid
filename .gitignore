# No dot-directories except github/vscode
.*/
!.vscode/
!.github/
!.devcontainer/
!.kiro/

*.code-workspace
node_modules
nbproject

# npm package files
iobroker.*.tgz

Thumbs.db
.commitinfo

# i18n intermediate files
admin/i18n/flat.txt
admin/i18n/*/flat.txt

# admin UI Vite intermediate build
src-admin/build/

# admin/ holds BOTH hand-maintained static files (icon .png, jsonCustom.json,
# style.css, i18n) and generated Vite output. Only the generated output is
# ignored; the hand-maintained files are committed (see tasks.js, which
# preserves .png/.json/.css/i18n on clean).
admin/assets/
admin/index.html
admin/tab.html

# build/ is the TypeScript compile output (generated from src/). It IS committed
# so the adapter can be installed directly from GitHub (ioBroker forbids install
# lifecycle scripts, so there is no build-on-install; the compiled entry point
# build/main.js must exist in the repo). Referenced via package.json "main".

# bundle analyzer output (ANALYZE=1 npm run build in src-admin)
src-admin/stats.html
admin/stats.html

#input
/input/