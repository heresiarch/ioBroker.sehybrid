# No dot-directories except github/vscode
.*/
!.vscode/
!.github/
!.devcontainer/
!.kiro/

*.code-workspace
node_modules
nbproject

# npm package files
iobroker.*.tgz

Thumbs.db
.commitinfo

# i18n intermediate files
admin/i18n/flat.txt
admin/i18n/*/flat.txt

# admin UI Vite intermediate build
src-admin/build/

# admin/ holds BOTH hand-maintained static files (icon .png, jsonCustom.json,
# style.css, i18n) and generated Vite output. Only the generated output is
# ignored; the hand-maintained files are committed (see tasks.js, which
# preserves .png/.json/.css/i18n on clean).
admin/assets/
admin/index.html
admin/tab.html

# build/ is the TypeScript compile output (generated from src/), NOT committed.
# The npm tarball ships it via package.json "files" + the "prepublishOnly" build
# hook, and io-package.json common.nogit=true tells the ioBroker checker the
# compiled output lives in npm rather than git (canonical full-TS adapter layout,
# see ioBroker.matter).
build/

# bundle analyzer output (ANALYZE=1 npm run build in src-admin)
src-admin/stats.html
admin/stats.html

#input
/input/